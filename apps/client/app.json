{
  "expo": {
    "name": "Lessive & Pliage",
    "slug": "laundry-platform",
    "version": "0.1.0",
    "scheme": "laundry",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A14",
    "splash": {
      "backgroundColor": "#0A0A14",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.laundry.platform",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A14"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
