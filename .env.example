# ─────────────────────────────────────────────────────────────
#  API — Base de données
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laundry?schema=public"

# ─────────────────────────────────────────────────────────────
#  API — Auth (JWT + refresh)
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ─────────────────────────────────────────────────────────────
#  API — Serveur
# ─────────────────────────────────────────────────────────────
API_PORT="4000"
API_HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:8081"

# ─────────────────────────────────────────────────────────────
#  Règles métier
# ─────────────────────────────────────────────────────────────
# Nombre de parrainages confirmés requis pour activer un compte
SPONSORSHIP_REQUIRED="5"
# Commission plateforme (0.15 = 15%)
PLATFORM_COMMISSION_RATE="0.15"

# ─────────────────────────────────────────────────────────────
#  Stripe Connect (mode test par défaut)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_CURRENCY="eur"

# ─────────────────────────────────────────────────────────────
#  Stockage fichiers (S3-compatible, MinIO en dev)
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-1"
S3_BUCKET="laundry-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ─────────────────────────────────────────────────────────────
#  Gens de Confiance
#  Provider actif : "manual" (repli, défaut) ou "trustfully" (API partenaire)
#  L'API partenaire n'est PAS self-service : partenariat sur demande auprès de GdC.
# ─────────────────────────────────────────────────────────────
GDC_PROVIDER="manual"
GDC_API_BASE_URL="https://api.trustfully.com/v1/"
GDC_API_KEY=""

# ─────────────────────────────────────────────────────────────
#  Client Expo (préfixe EXPO_PUBLIC_ pour exposer côté front)
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:4000"
