# Copiez ce fichier en `.env` et renseignez votre clé API Claude.
# La clé détermine le compte / l'organisation / l'espace de travail utilisés.
# Obtenez une clé sur https://platform.claude.com

ANTHROPIC_API_KEY=sk-ant-...

# (Optionnel) Modèle par défaut proposé au démarrage.
# Valeurs possibles : claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
DEFAULT_MODEL=claude-opus-5

# (Optionnel) Port du serveur (par défaut 3000)
PORT=3000
